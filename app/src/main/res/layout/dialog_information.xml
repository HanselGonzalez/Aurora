<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvInformation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="30dp"
        app:cardBackgroundColor="@color/navBottomPrimary"
        app:cardCornerRadius="25dp"
        app:cardElevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/cvLine"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Informacion Importante" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvLine"
                android:layout_width="0dp"
                android:layout_height="2dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/tvInformation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"

                />


            <TextView
                android:id="@+id/tvInformation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvLine"
                app:layout_constraintBottom_toTopOf="@id/cvLine2"

                tools:text="Esta aplicación es una herramienta independiente para la planificación familiar, desarrollada sin respaldo oficial. Es crucial que verifique toda la información proporcionada aquí con documentación oficial y consulte a profesionales de salud calificados antes de tomar decisiones basadas en esta aplicación. Parte de la información ha sido obtenida de fuentes confiables en salud pública."

                />


            <androidx.cardview.widget.CardView
                android:id="@+id/cvLine2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/tvInformationFooter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvInformation"

                />


            <TextView
                android:id="@+id/tvInformationFooter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvLine2"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Estos métodos no protegen contra la transmisión de ITS/VIH. Si existe riesgo
de ITS/VIH, se recomienda el uso correcto y sistemático de preservativos,
masculinos o femeninos."

                />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>